apiVersion: v1
kind: Pod
metadata:
  name: pod-c
  labels:
    app: testing
    team: in
    sc: mumbai
spec:
  containers:
  - name: pod-c
    image: vimal13/apache-webserver-php
    ports:
    - containerPort: 80

apiVersion: v1
kind: Service
metadata:
  name: my-service
spec:
  type: NodePort
  selector:
    app: testing
  ports:
  - protocol: TCP
    port: 80
    targetPort: 9376
